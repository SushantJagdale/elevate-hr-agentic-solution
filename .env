# Model auth - Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=learning-457908
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-2.5-flash

# Retrieval Mode: okf | rag | hybrid
RETRIEVAL_MODE=okf

# Guardrail & Safety thresholds
ENABLE_DLP_MASKING=true
GROUNDING_ATTRIBUTION_THRESHOLD=0.85
DEDUPLICATION_WINDOW_HOURS=24
AUDIT_LOG_PATH=./logs/audit_vault.jsonl

# Server Configuration
PORT=8080
HOST=0.0.0.0
